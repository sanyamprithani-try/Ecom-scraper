# Server
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# Scraping behaviour
SCRAPE_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=15.0
MAX_RESULTS_PER_SITE=5

# Proxy (optional — leave blank to scrape without proxies)
PROXY_URL=
PROXY_API_KEY=

# Database (optional — for future persistence layer)
DATABASE_URL=sqlite:///data/scraper.db
